# ============================================================================
# BenchMaxxer Project-Level Environment & API Key Configuration
# ============================================================================
# Used by:
#   1. BenchMaxxer evaluation runner (test, suite, and framework runs)
#   2. Token & credit telemetry script (@.agents/scripts/tokens)
#
# Format rules (enforced by .agents/scripts/tokens):
#   - Use literal KEY=VALUE assignments (no shell expansion or unquoted spaces).
#   - Exported shell variables take precedence over values in this file.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Token Overlay & Provider Usage Telemetry (@.agents/scripts/tokens)
# ----------------------------------------------------------------------------
TOKEN_OVERLAY_REFRESH_SECONDS=90

# Organization Admin API keys for provider-level token usage reporting
OPENAI_ADMIN_KEY=
OPENAI_ORGANIZATION=
ANTHROPIC_ADMIN_KEY=

# Google Cloud / Vertex AI online-serving token telemetry (Cloud Monitoring)
# Leave GOOGLE_CLOUD_PROJECT empty until ADC or GOOGLE_ACCESS_TOKEN is active
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional manual USD credit snapshots for .agents/scripts/tokens overlay
OPENAI_REMAINING_CREDITS_USD=
CLAUDE_REMAINING_CREDITS_USD=
GOOGLE_CLOUD_REMAINING_CREDITS_USD=

# Optional command adapters for .agents/scripts/tokens (must output single JSON object)
GOOGLE_AI_STUDIO_COMMAND=
GOOGLE_CLOUD_COMMAND=
CLAUDE_PLATFORM_COMMAND=
OPENAI_PLATFORM_COMMAND=

# ----------------------------------------------------------------------------
# 2. Evaluated Candidate & Critic Frontier Model API Keys (configs/models.yaml)
# ----------------------------------------------------------------------------
# Google Gemini / AI Studio / Vertex AI (gemini-1.5-pro, gemini-1.5-flash)
GEMINI_API_KEY=
GOOGLE_API_KEY=
VERTEX_PROJECT_ID=benchmaxxer-eval-sandbox
VERTEX_LOCATION=us-central1

# Anthropic Claude (claude-3-5-sonnet)
ANTHROPIC_API_KEY=

# OpenAI Compatible & Frontier Models
OPENAI_API_KEY=

# Open-Weights & Actor-Critic Panel Models (Qwen, MiniMax, Kimi K, Llama, Gemma)
QWEN_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
LLAMA_ENDPOINT_API_KEY=
GEMMA_ENDPOINT_API_KEY=
