#!/usr/bin/env bash
# Inherit exported credentials; default to project-level .env; launch once or control the existing overlay.
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
project_root="$(cd -- "$script_dir/../.." && pwd)"
if [[ -z "${TOKEN_OVERLAY_ENV:-}" && -f "$project_root/.env" ]]; then
  export TOKEN_OVERLAY_ENV="$project_root/.env"
fi
PYTHON_BIN="python3"
if [[ -x "$project_root/.venv/bin/python3" ]]; then
  PYTHON_BIN="$project_root/.venv/bin/python3"
elif [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python3" ]]; then
  PYTHON_BIN="$VIRTUAL_ENV/bin/python3"
fi
case "${1:-}" in
  --foreground)
    shift
    exec "$PYTHON_BIN" "$script_dir/token_overlay.py" "$@"
    ;;
  --check|--benchmaxxer|--refresh|--quit|--help|-h)
    exec "$PYTHON_BIN" "$script_dir/token_overlay.py" "$@"
    ;;
  ""|--show) ;;
  *) exec "$PYTHON_BIN" "$script_dir/token_overlay.py" "$@" ;;
esac
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/token-overlay-$(id -u)"
if [[ -L "$runtime_dir" ]]; then
  echo 'Error: overlay runtime directory must not be a symlink.' >&2
  exit 1
fi
mkdir -p -m 700 -- "$runtime_dir"
if [[ ! -O "$runtime_dir" ]]; then
  echo 'Error: overlay runtime directory is owned by another user.' >&2
  exit 1
fi
chmod 700 -- "$runtime_dir"
log_file="$runtime_dir/overlay.log"
if [[ -L "$log_file" ]]; then
  echo 'Error: overlay log must not be a symlink.' >&2
  exit 1
fi
umask 077
nohup "$PYTHON_BIN" "$script_dir/token_overlay.py" "$@" >>"$log_file" 2>&1 </dev/null &
echo "Overlay launch requested. Log: $log_file"
