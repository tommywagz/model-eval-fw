# ============================================================================
# devbench Project-Level Environment & API Key Template (.env.example)
# Copy to .env and populate keys for live evaluation and token cost telemetry.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Token Overlay & Provider Usage Telemetry (@.agents/scripts/tokens)
# ----------------------------------------------------------------------------
TOKEN_OVERLAY_REFRESH_SECONDS=90

OPENAI_ADMIN_KEY=
OPENAI_ORGANIZATION=
ANTHROPIC_ADMIN_KEY=

OPENAI_REMAINING_CREDITS_USD=
CLAUDE_REMAINING_CREDITS_USD=
GOOGLE_CLOUD_REMAINING_CREDITS_USD=

GOOGLE_AI_STUDIO_COMMAND=
GOOGLE_CLOUD_COMMAND=
CLAUDE_PLATFORM_COMMAND=
OPENAI_PLATFORM_COMMAND=

# ----------------------------------------------------------------------------
# 2. Google Cloud Platform & Vertex AI Configuration
# ----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=

# Default Vertex AI Location (global or us-central1 recommended)
# Note: On Google Cloud Vertex AI, different model families and Model Garden
# partner models are deployed in specific regional clusters:
#
# ============================================================================
# DEFAULT LOCATIONS BY MODEL CONFIGURATION (configs/models.yaml)
# ============================================================================
# Location        | Model Families / Providers         | Configured Models
# ----------------|------------------------------------|--------------------------------------------------
# global          | Google Gemini Frontier Models      | gemini-3.5-flash (Default Model)
#                 |                                    | gemini-3.8-flash
#                 |                                    | gemini-3.1-pro-preview / gemini-3.1-pro
#                 |                                    | gemini-3-pro
#                 |                                    | gemini-3-flash
#                 |                                    | gemini-4-argon
#                 |                                    | (Recommended: high availability & sub-second latency)
# ----------------|------------------------------------|--------------------------------------------------
# us-central1     | Google Gemini Regional &           | gemini-3.5-pro
#                 | Model Garden MaaS Serverless       | llama-3.1-8b, llama (Meta MaaS)
#                 | Partner Models                     | grok-2-mini, grok (xAI MaaS)
#                 |                                    | muse (Google MaaS)
#                 |                                    | eleven-turbo-v2, eleven-labs (ElevenLabs)
#                 |                                    | fable-5.1, critic-qwen (Dedicated Endpoints)
# ----------------|------------------------------------|--------------------------------------------------
# global          | Anthropic Claude Partner Models    | claude-sonnet-4-6 (Default Frontier Critic)
#                 | (Vertex AI Partner Model Garden)   | claude-sonnet-4-5, claude-haiku-4-5
#                 |                                    | claude-sonnet-5.5, claude-opus-5.5, claude-opus-5.1
#                 |                                    | critic-frontier-anthropic
# ----------------|------------------------------------|--------------------------------------------------
# europe-west4    | Mistral AI Partner Models          | mistral-small (Mistral MaaS)
#                 | (Vertex AI Partner Model Garden)   | mistral-large-3 (Mistral MaaS)
#                 |                                    | mistral-large-latest (Mistral Endpoint)
# ============================================================================
GOOGLE_CLOUD_LOCATION=global

# Secondary/Fallback Vertex location variables
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global

# ----------------------------------------------------------------------------
# Dedicated Actor (Candidate) vs Critic GCP Locations & Projects
# Supports distinct projects/regions when actor and critic models require different
# endpoints (e.g. Actor in global and Critic in a separate project),
# or when both happen to be hosted in 'global' (e.g. Gemini Actor & Gemini Critic).
# ----------------------------------------------------------------------------
ACTOR_PROJECT_ID=
ACTOR_LOCATION=global

CRITIC_PROJECT_ID=
CRITIC_LOCATION=global

# ----------------------------------------------------------------------------
# 3. Direct Provider API Keys (Optional Fallbacks / Mode C)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

QWEN_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
